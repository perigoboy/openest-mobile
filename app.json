{
  "expo": {
    "name": "openest-mobile",
    "slug": "openest-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-chama.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Openest acessa suas fotos para voce trocar a foto do seu perfil.",
          "cameraPermission": "O Openest usa a camera para voce tirar uma foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ]
  }
}
