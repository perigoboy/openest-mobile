{
  "expo": {
    "name": "Openest",
    "slug": "openest-mobile",
    "description": "Openest — conexões abertas e seguras para solteiros, casais e grupos.",
    "version": "1.0.0",
    "scheme": "openest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0D0D0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openest.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.openest.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E003B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Openest acessa suas fotos para voce trocar a foto do seu perfil.",
          "cameraPermission": "O Openest usa a camera para voce tirar uma foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Openest usa sua localização para mostrar pessoas perto de você no Discovery.",
          "locationAlwaysAndWhenInUsePermission": "O Openest usa sua localização para mostrar pessoas perto de você no Discovery."
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E003B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8E44AD",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
